```python
#!/usr/bin/env python3
import subprocess
import os
import datetime
import tarfile

def create_backup():
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    backup_dir = f"/home/ubuntu/backups/{timestamp}"
    
    # å»ºç??™ä»½?®é?
    os.makedirs(backup_dir, exist_ok=True)
    
    # ?™ä»½å°ˆæ?æª”æ?
    subprocess.run([
        'tar', '-czf', f'{backup_dir}/kkgroup.tar.gz',
        '-C', '/home/ubuntu', 'kkgroup'
    ], check=True)
    
    # ?™ä»½è³‡æ?åº?    subprocess.run([
        'cp', '/home/ubuntu/kkgroup/data/database.db',
        f'{backup_dir}/database.db'
    ], check=True)
    
    # æ¸…ç??Šå?ä»?(ä¿ç?30å¤?
    subprocess.run([
        'find', '/home/ubuntu/backups', '-type', 'd',
        '-mtime', '+30', '-exec', 'rm', '-rf', '{}', ';'
    ], check=True)
    
    print(f"?™ä»½å®Œæ?: {backup_dir}")

if __name__ == "__main__":
    create_backup()
```


#!/bin/bash
# PRE-PUSH HOOK: Blocking Codex Review (local, mandatory)
# Requires: npm install -g codex-claude-bridge
set -euo pipefail

ROOT_DIR=$(git rev-parse --show-toplevel)
export ROOT_DIR
HOOK_LOG=$ROOT_DIR/.claude/logs/pre-push-$(date +%Y%m%d-%H%M%S).log
mkdir -p $ROOT_DIR/.claude/logs

log() { echo "[$(date +%H:%M:%S)] $*" | tee -a $HOOK_LOG; }
info() { log "INFO: $*"; }
warn() { log "WARN: $*"; }
err() { log "ERROR: $*"; }

STDIN_DATA=$(cat)
parts=($STDIN_DATA)

# Guard: if no stdin data, just allow push
if [[ -z "$STDIN_DATA" || ${#parts[@]} -lt 4 ]]; then
    info "No stdin data, allowing push"
    exit 0
fi

LOCAL_REF=${parts[0]}
LOCAL_SHA=${parts[1]}
REMOTE_REF=${parts[2]}
REMOTE_SHA=${parts[3]}

info "Push: $LOCAL_REF -> $REMOTE_REF"

# Get diff for pushed commits (exclude test/docs/config files)
if [[ "$REMOTE_SHA" != "0000000000000000000000000000000000000000" ]]; then
    DIFF=$(git diff $REMOTE_SHA..$LOCAL_SHA -- . \
      ':!tests/**' ':!docs/**' ':!*.md' \
      ':!.venv/' ':!node_modules/' ':!.claude/worktrees/' \
      ':!chroma_db/' ':!graphify-out/' ':!game/' \
      ':!tools/' ':!docs_and_tests/' 2>/dev/null || true)
else
    DIFF=$(git diff --name-only $LOCAL_SHA -- . \
      ':!tests/**' ':!docs/**' ':!*.md' \
      ':!.venv/' ':!node_modules/' ':!.claude/worktrees/' \
      ':!chroma_db/' ':!graphify-out/' ':!game/' \
      ':!tools/' ':!docs_and_tests/' 2>/dev/null || true)
fi

# No code changes? Allow push
if [[ -z "$DIFF" ]]; then
    info "No code changes to review, allowing push"
    exit 0
fi

info "Running Codex review on diff..."
info "Diff size: ${#DIFF} chars"

# Run Codex review with timeout - simple pipe with explicit path
info "Starting codex-claude-bridge..."
if ! timeout 120 bash -c "echo \"\$DIFF\" | /c/Users/88697/AppData/Roaming/npm/codex-claude-bridge review-code --diff - --session \"pre-push-\$(date +%s)\" --json > /tmp/prepush-review.json 2>&1"; then
    info "Codex timed out or failed (exit code: \$?)"
    info "Allowing push despite timeout"
else
    info "Codex review completed"
fi
cat /tmp/prepush-review.json

# Parse verdict
VERDICT=$(cat /tmp/prepush-review.json | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    print(data.get('verdict', 'unknown'))
except:
    print('unknown')
" 2>/dev/null || echo "unknown")

# Print findings
cat /tmp/prepush-review.json | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    findings = data.get('findings', [])
    if findings:
        print('')
        print('=== Codex Findings ===')
        for f in findings:
            file = f.get('file', 'general')
            line = f.get('line', 0)
            msg = f.get('message', '')
            print(f'  {file}:{line} - {msg}')
    elif data.get('verdict') == 'approved':
        print('')
        print('✅ No issues found')
except:
    pass
"

# Decision
case "$VERDICT" in
    approved)
        info "Codex approved - push allowed"
        exit 0
        ;;
    changes_requested|rejected)
        err "Codex verdict: $VERDICT"
        err "Fix the issues above, then push again"
        err "To skip (not recommended): git push --no-verify"
        exit 1
        ;;
    *)
        warn "Codex verdict unclear: $VERDICT"
        warn "Allowing push but review output above for reference"
        exit 0
        ;;
esac
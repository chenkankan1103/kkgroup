    "sheets": {
      "sync": {
        "method": "POST",
        "path": "/api/sync",
        "description": "同步 Google Sheets 資料到 DB",
        "auth_required": true,
        "parameters": ["spreadsheet_id", "sheets"],
        "response_code": 200,
        "error_codes": [400, 401, 403]
      },
      "export": {
        "method": ["GET", "POST"],
        "path": "/api/export",
        "description": "導出 DB 資料為 Sheets 格式",
        "auth_required": true,
        "parameters": ["format", "sheet_id"],
        "response_code": 200,
        "error_codes": [400, 401, 403]
      }
      "clean_virtual": {
        "method": "POST",
        "path": "/api/clean-virtual",
        "description": "清理虛擬帳號",
        "auth_required": true,
        "admin_required": true,
        "parameters": ["before_date", "exclude_ids"],
        "response_code": 200,
        "error_codes": [400, 401, 403]
      },
      "get_user": {
        "method": "GET",
        "path": "/api/user/<id>",
        "description": "取得用戶資料",
        "auth_required": false,
        "parameters": ["id"],
        "response_code": [200, 404],
        "error_codes": [400, 401]
      },
      "update_user": {
        "method": "PUT",
        "path": "/api/user/<id>",
        "description": "更新用戶資料",
        "auth_required": true,
        "parameters": ["id"],
        "body_parameters": ["nickname", "coins", "level"],
        "response_code": 200,
        "error_codes": [400, 401, 404]
      }
    },

    "game": {
      "paperdoll": {
        "method": ["GET", "POST"],
        "path": "/api/game/user/<user_id>/paperdoll",
        "description": "取得/更新用戶紙娃娃配置",
        "auth_required": false,
        "parameters": ["user_id"],
        "response_code": 200,
        "error_codes": [400, 404]
      }
    }
  },


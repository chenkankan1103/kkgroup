    "homepage_schedule_format": {
      "source": "newanime-date-area divs on https://ani.gamer.com.tw/",
      "fields": {
        "data-animesn": "animeSn (integer)",
        "data-date-code": "dayOfWeek (1=Mon, 2=Tue, ..., 7=Sun)",
        "animeVideo.php?sn=VIDEO_SN": "videoSn (integer, extracted from link)",
        "p.anime-name": "title (string)",
        "span.anime-hours": "scheduled_time (HH:MM)",
        "p>蝚?N?": "episode (e.g., '第1集')"

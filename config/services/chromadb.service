[Unit]
Description=Chroma Vector Database Server
After=network-online.target systemd-resolved.service
Wants=network-online.target
Requires=systemd-resolved.service

[Service]
Type=simple
User=e193752468
Group=e193752468
WorkingDirectory=/home/e193752468/kkgroup
Environment=PATH=/home/e193752468/kkgroup/venv/bin
Environment=PYTHONPATH=/home/e193752468
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8
Environment=LANGUAGE=zh_TW.UTF-8
Environment=TZ=Asia/Taipei
# Chroma server configuration
Environment=CHROMA_SERVER_HOST=0.0.0.0
Environment=CHROMA_SERVER_HTTP_PORT=8000
Environment=CHROMA_DB_PATH=/home/e193752468/chroma_db
Environment=CHROMA_SERVER_NOFILE=65535
ExecStart=/home/e193752468/kkgroup/venv/bin/chromadb run --host 0.0.0.0 --port 8000 --path /home/e193752468/chroma_db
Restart=on-failure
RestartSec=10
StartLimitBurst=3
StartLimitInterval=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chromadb
SyslogFacility=daemon
SyslogLevel=info

# Memory limits for e2-micro
MemoryMax=500M
MemorySwapMax=800M
OOMScoreAdjust=0

TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target

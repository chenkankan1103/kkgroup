[Unit]
Description=KKGroup VM Self-Healing Daemon
After=network-online.target bot.service shopbot.service uibot.service
Wants=network-online.target
Documentation=https://github.com/chenkankan1103/kkgroup

[Service]
Type=simple
User=e193752468
WorkingDirectory=/home/e193752468/kkgroup
ExecStart=/usr/bin/python3 /home/e193752468/kkgroup/scripts/auto_self_heal.py --watch --interval 300
Restart=on-failure
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=600

# 環境變量
Environment=PYTHONIOENCODING=utf-8
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=TZ=Asia/Taipei

# 安全限制
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
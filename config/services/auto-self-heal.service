[Unit]
Description=KKGroup VM Self-Healing Daemon
After=network-online.target bot.service shopbot.service uibot.service
Wants=network-online.target
Documentation=https://github.com/chenkankan1103/kkgroup

[Service]
Type=simple
User=e193752468
Group=e193752468
WorkingDirectory=/home/e193752468/kkgroup

# venv 路徑（auto_self_heal.py 需用 requests / 專案模組）
Environment=PATH=/home/e193752468/kkgroup/venv/bin
Environment=PYTHONPATH=/home/e193752468
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8
Environment=TZ=Asia/Taipei

ExecStart=/home/e193752468/kkgroup/venv/bin/python /home/e193752468/kkgroup/scripts/auto_self_heal.py --watch --interval 300

# A5: Restart=always 確保 SIGTERM（部署）後自動拉回，不再躺 28 天
Restart=always
RestartSec=30
StartLimitBurst=5
StartLimitIntervalSec=600

StandardOutput=journal
StandardError=journal
SyslogIdentifier=auto-self-heal
SyslogFacility=daemon
SyslogLevel=info

TimeoutStopSec=30
KillMode=mixed

# 安全限制
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
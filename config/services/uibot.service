[Unit]
Description=Discord UI Bot
After=network-online.target systemd-resolved.service chromadb.service
Wants=network-online.target chromadb.service
Requires=systemd-resolved.service

[Service]
Type=simple
User=e193752468
Group=e193752468
WorkingDirectory=/home/e193752468/kkgroup
Environment=PATH=/home/e193752468/kkgroup/venv/bin
Environment=PYTHONPATH=/home/e193752468
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8
Environment=LANGUAGE=zh_TW.UTF-8
Environment=TZ=Asia/Taipei
# Chroma Server 模式
Environment=USE_CHROMA_SERVER=true
Environment=CHROMA_SERVER_HOST=127.0.0.1
Environment=CHROMA_SERVER_PORT=8000
ExecStart=/home/e193752468/kkgroup/venv/bin/python /home/e193752468/kkgroup/bots/uibot.py
Restart=on-failure
RestartSec=30
StartLimitBurst=3
StartLimitInterval=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=uibot
SyslogFacility=daemon
SyslogLevel=info

# Memory limits for e2-micro (1GB RAM) - prevent OOM kills
MemoryMax=250M
MemorySwapMax=400M
OOMScoreAdjust=100

TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target

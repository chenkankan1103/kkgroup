{
    "autoCompactEnabled":  true,
    "autoCompactWindow":  1000000,
    "hooks":  {
                  "Stop":  [
                               {
                                   "matcher":  ".*",
                                   "hooks":  [
                                                 {
                                                     "type":  "command",
                                                     "command":  "powershell -File .claude/scripts/consensus-review.ps1",
                                                     "timeout":  180
                                                 }
                                             ]
                               }
                           ]
              },
    "permissions":  {
                        "allow":  [
                                      "Read(*)",
                                      "Write(*)",
                                      "Edit(*)",
                                      "Glob(*)",
                                      "Grep(*)",
                                      "Bash(*)",
                                      "PowerShell(*)",
                                      "mcp__claude-flow__*"
                                  ],
                        "deny":  [
                                     "Write(./.env)",
                                     "Write(./.env.*)",
                                     "Edit(./.env)",
                                     "Edit(./.env.*)",
                                     "Bash(rm -rf /)",
                                     "Bash(rm -rf /*)",
                                     "Bash(rm -rf ~)",
                                     "Bash(rm -rf ~*)",
                                     "Bash(git push --force *)",
                                     "Bash(git reset --hard *)",
                                     "Bash(rm -rf .*)",
                                     "Bash(rm *)",
                                     "PowerShell(Remove-Item -Recurse -Force *)",
                                     "PowerShell(Remove-Item *)"
                                 ]
                    },
    "additionalDirectories":  [
                                  "C:\\Users\\88697\\Desktop\\kkgroup"
                              ]
}
